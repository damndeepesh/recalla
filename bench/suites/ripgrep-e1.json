      "commit": "95cea77625f978a21b1d923e54d13f9217f0ef30",
      "split": "tune",
      "state": "live",
      "survival": 0.89
    },
    {
      "id": "f79d40d0e-0",
      "kind": "decision",
      "text": "The other issue this fixes is that binary detection is now applied to every buffer instead of just the first one.",
